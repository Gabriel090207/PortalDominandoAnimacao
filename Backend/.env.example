# Local development: path relative to Backend.
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# Render: set the complete service account JSON as a secret in the dashboard.
# A non-empty JSON value takes precedence over the file path.
FIREBASE_CREDENTIALS_JSON=

# Configure the real shared token only in private environment/secrets.
KIRVANO_WEBHOOK_TOKEN=

# Explicit IANA timezone for offset-free commercial webhook timestamps.
KIRVANO_WEBHOOK_TIMEZONE=America/Sao_Paulo

# Independent secret for email identity HMAC; never reuse webhook/Firebase secrets.
# Configure a strong secret privately. Rotation requires a versioned migration.
EMAIL_IDENTITY_HMAC_SECRET=

# Dedicated administrative admission key. Optional until Admin is explicitly initialized.
# Exactly 64 lowercase hex characters from 32 cryptographically random bytes.
# Never reuse commercial/webhook secrets; never commit the real value.
# All instances must use identical key/version. Rotation requires a planned transition.
ADMIN_ADMISSION_HMAC_SECRET=
