# ONLY inside the dedicated Admin subdomain document root, never the main site.
# Requires approved Apache/LiteSpeed rewrite, headers and per-directory overrides.
# Generated by build:hosting; do not publish this unresolved template.
Options -Indexes -MultiViews
DirectoryIndex index.html
RewriteEngine On
# Missing assets must return 404, not the SPA HTML.
RewriteRule ^assets/ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src __ADMIN_API_ORIGIN__; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
# Conservative default, also applied to fallback HTML and error responses.
Header always set Cache-Control "no-store"
# Only Vite content-hashed JS/CSS get immutable caching.
<FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200"
</FilesMatch>
